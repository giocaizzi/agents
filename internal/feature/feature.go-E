// Package feature is the single source of which configuration keys each
// harness supports: for every key, whether agents writes it to a harness
// (rendered), the harness has no such setting (unsupported) or the harness has
// one that agents does not write yet (planned). The schema descriptions,
// agents check, agents features and docs/features.md all read this table.
//
// The package imports no other part of agents so that the config package can
// use it to describe its own schema.
package feature

import (
	"slices"
	"strings"
)

// Status is how a harness relates to a configuration key.
type Status string

// The three statuses of a Cell.
const (
	Rendered    Status = "rendered"    // agents writes the key to the harness
	Unsupported Status = "unsupported" // the harness has no native setting for it
	Planned     Status = "planned"     // the harness has a setting that agents does not write yet
)

// Scopes of a Feature.
const (
	ScopeShared   = "shared"   // every harness has a cell
	ScopeHarness  = "harness"  // harness-specific: only that harness has a cell
	ScopeInternal = "internal" // not harness-facing: no cells
)

// Cell is the support of one key on one harness.
type Cell struct {
	Status Status `json:"status"`
	// Target is the file and key path agents writes (rendered only).
	Target string `json:"target,omitempty"`
	// Evidence is the documentation checked (unsupported) or the reason the key
	// is not written yet (planned).
	Evidence string `json:"evidence,omitempty"`
}

// Feature is one configuration key, or a key prefix whose keys behave alike.
// A "*" segment of Key matches any one segment, for the free names of maps.
type Feature struct {
	Key     string          `json:"key"`
	Scope   string          `json:"scope"`
	Summary string          `json:"summary"`
	Cells   map[string]Cell `json:"cells,omitempty"` // by harness id
}

// Lookup returns the feature with the longest key that is a segment prefix of
// key, where a "*" segment of the feature key matches any segment.
func Lookup(key string) (Feature, bool) {
	segs := strings.Split(key, ".")
	best, bestLen := -1, 0
	for i, f := range Features {
		fs := strings.Split(f.Key, ".")
		if len(fs) > len(segs) || len(fs) <= bestLen {
			continue
		}
		if slices.EqualFunc(fs, segs[:len(fs)], func(a, b string) bool { return a == "*" || a == b }) {
			best, bestLen = i, len(fs)
		}
	}
	if best < 0 {
		return Feature{}, false
	}
	return Features[best], true
}

// Describe is the summary of key's feature followed by a compact support line,
// for schema descriptions. It is empty when no feature covers key.
func Describe(key string) string {
	f, ok := Lookup(key)
	if !ok {
		return ""
	}
	if f.Scope == ScopeInternal {
		return f.Summary
	}
	var parts []string
	for _, st := range []struct {
		s     Status
		label string
	}{{Rendered, "Written to"}, {Planned, "Planned for"}, {Unsupported, "Not supported by"}} {
		if hs := f.Harnesses(st.s); len(hs) > 0 {
			parts = append(parts, st.label+" "+strings.Join(hs, ", ")+".")
		}
	}
	return strings.TrimSpace(f.Summary + " " + strings.Join(parts, " "))
}

// Harnesses lists the harness ids whose cell has status s, in canonical order.
func (f Feature) Harnesses(s Status) []string {
	var out []string
	for _, h := range HarnessIDs() {
		if c, ok := f.Cells[h]; ok && c.Status == s {
			out = append(out, h)
		}
	}
	return out
}

// Planned lists the features with at least one planned cell.
func Planned() []Feature {
	var out []Feature
	for _, f := range Features {
		if len(f.Harnesses(Planned)) > 0 {
			out = append(out, f)
		}
	}
	return out
}

// Harness ids, equal to the config package's.
const (
	claude      = "claude"
	copilot     = "copilot"
	vscode      = "vscode"
	codex       = "codex"
	opencode    = "opencode"
	pi          = "pi"
	antigravity = "antigravity"
)

// HarnessIDs lists the harness ids in canonical order.
func HarnessIDs() []string {
	return []string{claude, copilot, vscode, codex, opencode, pi, antigravity}
}

// Checked is the month the unsupported and planned evidence was gathered.
const Checked = "2026-11"

// Source is the documentation of harness h that the evidence refers to.
func Source(h string) string {
	switch h {
	case claude:
		return "https://docs.claude.com/en/docs/claude-code/settings"
	case copilot:
		return "https://docs.github.com/en/copilot/how-tos/copilot-cli"
	case vscode:
		return "https://code.visualstudio.com/docs/copilot"
	case codex:
		return "https://developers.openai.com/codex/config-reference"
	case opencode:
		return "https://opencode.ai/docs/config"
	case pi:
		return "https://github.com/badlogic/pi-mono (coding-agent settings)"
	case antigravity:
		return "Antigravity CLI settings documentation"
	}
	return ""
}

// evidence is what a non-rendered cell records: the source, when it was
// checked and what was found.
func evidence(h, what string) string {
	return Source(h) + " (checked " + Checked + "): " + what
}

// Detail is the part of a non-rendered cell's evidence after the source.
func Detail(h string, c Cell) string {
	d, _ := strings.CutPrefix(c.Evidence, evidence(h, ""))
	return d
}
